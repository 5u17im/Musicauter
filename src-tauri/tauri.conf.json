{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Audionave",
  "version": "0.1.0",
  "identifier": "com.audionave.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Audionave",
        "width": 1180,
        "height": 780,
        "minWidth": 880,
        "minHeight": 620,
        "center": true,
        "resizable": true,
        "decorations": false,
        "visible": true,
        "backgroundColor": "#101318"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "Audionave",
    "copyright": "Copyright (c) 2026 Audionave",
    "category": "Music",
    "shortDescription": "Reproductor, descargador y organizador de musica",
    "longDescription": "Audionave descarga playlists de YouTube a tu disco, reproduce tu biblioteca local y organiza artista, album y caratulas automaticamente. Funciona sin conexion una vez descargada la musica.",
    "createUpdaterArtifacts": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "binaries/yt-dlp.exe": "binaries/yt-dlp.exe",
      "binaries/ffmpeg.exe": "binaries/ffmpeg.exe"
    },
    "windows": {
      "allowDowngrades": false,
      "nsis": {
        "installMode": "currentUser",
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": true,
        "compression": "lzma"
      }
    }
  }
}
